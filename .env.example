# Copy to .env. Do not commit .env.

# API + production web server
PORT=8787
HOST=127.0.0.1
DATA_DIR=data

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# Set both to charge real cards through Razorpay. Leave blank for test checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0
